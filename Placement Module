function module:activate(id ,PlacedObjects,Plot,Stackable)
	
	if object then
		object:Destroy()
	end
	
	if not ItemLocation:FindFirstChild(id) then
		return
	end
	
	object = ItemLocation:FindFirstChild(id):Clone()
	object:SetAttribute("Placing",true)
	Placedobjects = PlacedObjects
	plot = Plot
	stackable = Stackable
	rotation = 0
	
	lastValidCFrame = nil
	lastPosition = nil

	
	player:SetAttribute("Placing",true)
	
	if player:GetAttribute("InTutorial") then
		-- force the player to place near the tent with it being inside the Bombers range
	end
	
	if not objectHitbox then
		local outline = Instance.new("Part")
		outline.Name = "PlacementHitboxOutline"
		outline.Anchored = true
		outline.CanCollide = false
		outline.CanQuery = false
		outline.CanTouch = false
		outline.Transparency = 0.85
		outline.Size = Vector3.new(object.PrimaryPart.Size.X,object.PrimaryPart.Size.Y * .1,object.PrimaryPart.Size.Z) + Vector3.new(1,0,1)
		outline.CFrame = CFrame.new(object.PrimaryPart.Position - Vector3.new(0,object.PrimaryPart.Size.Y/2,0))
		outline.Parent = object
		outline.Color = Color3.fromRGB(255, 0, 0)
		outline.Material = Enum.Material.Neon

		local newhighlight = Instance.new("Highlight")
		newhighlight.FillTransparency = .75 
		newhighlight.FillColor = Color3.fromRGB(255, 0, 0)
		newhighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		newhighlight.OutlineTransparency = 1
		newhighlight.Parent = outline
		newhighlight.Adornee = object
		newhighlight.DepthMode = Enum.HighlightDepthMode.Occluded

		local selectionbox = Instance.new("SelectionBox")
		selectionbox.Name = "PlacementHitboxOutline"
		selectionbox.Adornee = outline
		selectionbox.Color3 = Color3.fromRGB(255, 0, 0)
		selectionbox.LineThickness = .15
		selectionbox.SurfaceTransparency = 1
		selectionbox.Parent = outline


		objectHitbox = outline
	end


	for _,v in pairs(object:GetDescendants()) do
		if v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("UnionOperation") then
			v.Anchored = true
			v.CanCollide = false
		end
	end

	if not approvePlacement() then
		return
	end

	if object:HasTag("Bombers") then
		object:SetAttribute("RangeHighlight",true)
		object:AddTag("Placing")
	end

	RotationVal = true

	if not stackable  then
		mouse.TargetFilter = Placedobjects
	else
		mouse.TargetFilter = object
	end



	local prespeed = 1

	if interpolation then
		prespeed = math.clamp(math.abs(tonumber(1 - LerpSpeed)),0,.9)
	else
		prespeed = speed
	end

	object.Parent = Placedobjects
	showHitboxOutlines()
	rendergrid()
	task.wait()

	bindInputs()
	speed = prespeed
	
	return true

end

