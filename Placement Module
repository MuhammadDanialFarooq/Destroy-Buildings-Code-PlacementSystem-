local function changeHitboxColor()
	if object.PrimaryPart then
		highlight.Adornee = object
		object.PrimaryPart.Transparency = 1
		
		if collided then
			highlight.FillColor = Color3.fromRGB(255,66,66)
			object.PrimaryPart.Color = Color3.fromRGB(255,66,66)
			if objectHitbox then
				objectHitbox.Color = Color3.fromRGB(134, 0, 0)
				if objectHitbox:FindFirstChild("PlacementHitboxOutline") then
					objectHitbox.PlacementHitboxOutline.Color3 = Color3.fromRGB(255,0,0)
				end
				if objectHitbox:FindFirstChild("Highlight") then
					objectHitbox.Highlight.FillColor = Color3.fromRGB(134, 0, 0)
				end
			end
		else
			if objectHitbox then
				objectHitbox.Color = Color3.fromRGB(0, 85, 0)
				if objectHitbox:FindFirstChild("PlacementHitboxOutline") then
					objectHitbox.PlacementHitboxOutline.Color3 = Color3.fromRGB(0,255,0)
				end
				if objectHitbox:FindFirstChild("Highlight") then
					objectHitbox.Highlight.FillColor = Color3.fromRGB(0, 85, 0)
				end
			end
			highlight.FillColor = Color3.fromRGB(0, 255, 0)
			object.PrimaryPart.Color = Color3.fromRGB(0, 255, 0)
		end
	else
		highlight.Adornee = nil
	end
end
local function getTutorialTent()
	if not player:GetAttribute("InTutorial") then
		return nil
	end

	if not plot then
		return nil
	end

	local placed = plot:FindFirstChild("Placed")
	if not placed then
		return nil
	end

	local breakables = placed:FindFirstChild("Breakables")
	local tent = breakables and breakables:FindFirstChild("Tent")

	if tent and tent:IsA("Model") and tent.PrimaryPart then
		return tent
	end

	return nil
end

local function getTutorialBomber()
	if not player:GetAttribute("InTutorial") then
		return nil
	end

	if not Placedobjects then
		return nil
	end

	local bombers = Placedobjects:FindFirstChild("Bombers")
	if not bombers then
		return nil
	end

	for _, bomber in ipairs(bombers:GetChildren()) do
		if bomber:IsA("Model") and bomber.PrimaryPart then
			local range = bomber:GetAttribute("Range")

			if range then
				return bomber, range
			end
		end
	end

	return nil
end


local function isValidTutorialPosition(position)
	if not player:GetAttribute("InTutorial") then
		return true
	end

	local tent = getTutorialTent()
	local bomber, bomberRange = getTutorialBomber()

	if not tent or not bomber or not bomberRange then
		return true
	end

	local positionXZ = Vector3.new(position.X, 0, position.Z)

	local tentXZ = Vector3.new(
		tent.PrimaryPart.Position.X,
		0,
		tent.PrimaryPart.Position.Z
	)

	local bomberXZ = Vector3.new(
		bomber.PrimaryPart.Position.X,
		0,
		bomber.PrimaryPart.Position.Z
	)

	local nearTent = (positionXZ - tentXZ).Magnitude <= TUTORIAL_TENT_DISTANCE
	local insideBomberRange = (positionXZ - bomberXZ).Magnitude <= bomberRange

	return nearTent and insideBomberRange
end

local function handlecollision(position)
	if not object then
		return
	end

	collided = false

	local collisionpoint = object.PrimaryPart.Touched:Connect(function()
	end)

	local collisionpoints = object.PrimaryPart:GetTouchingParts()

	for i = 1, #collisionpoints do
		if not collisionpoints[i]:IsDescendantOf(object)
			and not collisionpoints[i]:IsDescendantOf(Character)
			and not collisionpoints[i]:IsDescendantOf(workspace.Orbs) then

			collided = true
			break
		end
	end

	collisionpoint:Disconnect()

	if not isValidTutorialPosition(position) then
		collided = true
	end
end

local function bounds(cf , offsetx,offsetz)
	local LowerXBound , UpperXBound
	local LowerZBound , UpperZBound
	
	LowerXBound = plot.Position.X - (plot.Size.X * .5) + offsetx
	UpperXBound = plot.Position.X + (plot.Size.X * .5) - offsetx
	
	LowerZBound = plot.Position.Z - (plot.Size.Z * .5) + offsetz
	UpperZBound = plot.Position.Z + (plot.Size.Z * .5) - offsetz
	
	local newX = clamp(cf.X,LowerXBound,UpperXBound) 
	local newZ = clamp(cf.Z,LowerZBound,UpperZBound) 
	
	return cframe(newX,posY,newZ)
end

local function approvePlacement()
	if not verifyPlane() then
		warn("The Model cannot snap on the plot.")
		return false
	end

	if GridSize >= math.min(plot.Size.X,plot.Size.Z) then
		warn("Grid Size is too big")
		return false
	end

	return true
end

local function calculateYPosition(toP,toS,oS)
	return (toP + toS *.5) + oS * .5
end

local function rotate(actionName,InputState,InputObj)
	if InputState == Enum.UserInputState.Begin then
		rotation += rotationStep
		RotationVal = not RotationVal
	end
end

function module:Rotate()
	rotation += rotationStep
	RotationVal = not RotationVal

	if object and lastValidCFrame then
		local newCFrame =
			CFrame.new(lastValidCFrame.Position)
			* CFrame.Angles(0, math.rad(rotation), 0)

		lastValidCFrame = newCFrame
		object:PivotTo(newCFrame)

		handlecollision(newCFrame.Position)
		changeHitboxColor()
	end
end

