local function verifyPlane()
	return plot.Size.X%GridSize == 0 and plot.Size.Z%GridSize == 0
end

local function removeHitboxOutline(model: Instance)
	local outline = hitboxOutlines[model]

	if outline then
		outline:Destroy()
		hitboxOutlines[model] = nil
	end
end

local function isPointerOverUI()
	local guiObjects = player.PlayerGui:GetGuiObjectsAtPosition(mouse.X, mouse.Y)

	for _, guiObject in ipairs(guiObjects) do
		if guiObject:IsA("GuiObject")
			and guiObject.Visible
			and guiObject.Active then

			return true
		end
	end

	return false
end

local function addHitboxOutline(model: Instance)
	if not model:IsA("Model") then
		return
	end

	if model == object then
		return
	end

	if model:GetAttribute("Placing") then
		return
	end

	local primaryPart = model.PrimaryPart

	if not primaryPart then
		return
	end

	if hitboxOutlines[model] then
		return
	end

	local outline = Instance.new("Part")
	outline.Name = "PlacementHitboxOutline"
	outline.Anchored = true
	outline.CanCollide = false
	outline.CanQuery = false
	outline.CanTouch = false
	outline.Transparency = 0.85
	outline.Size = Vector3.new(primaryPart.Size.X,primaryPart.Size.Y * .1,primaryPart.Size.Z) + Vector3.new(1,0,1)
	outline.CFrame = CFrame.new(primaryPart.Position - Vector3.new(0,primaryPart.Size.Y/2,0))
	outline.Parent = primaryPart
	outline.Color = Color3.fromRGB(255, 0, 0)
	outline.Material = Enum.Material.Neon
	
	local newhighlight = Instance.new("Highlight")
	newhighlight.FillTransparency = .75
	newhighlight.FillColor = Color3.fromRGB(255, 0, 0)
	newhighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	newhighlight.OutlineTransparency = 0
	newhighlight.Parent = outline
	newhighlight.Adornee = model
	newhighlight.DepthMode = Enum.HighlightDepthMode.Occluded
	
	local selectionbox = Instance.new("SelectionBox")
	selectionbox.Name = "PlacementHitboxOutline"
	selectionbox.Adornee = outline
	selectionbox.Color3 = Color3.fromRGB(255, 0, 0)
	selectionbox.LineThickness = .15
	selectionbox.SurfaceTransparency = 1
	selectionbox.Parent = outline


	hitboxOutlines[model] = outline
end

local function clearHitboxOutlines()
	if placedAddedConnection then
		placedAddedConnection:Disconnect()
		placedAddedConnection = nil
	end

	if placedRemovedConnection then
		placedRemovedConnection:Disconnect()
		placedRemovedConnection = nil
	end

	for model, outline in pairs(hitboxOutlines) do
		outline:Destroy()
		hitboxOutlines[model] = nil
	end
end

local function showHitboxOutlines()
	clearHitboxOutlines()

	if not Placedobjects then
		warn("No Placed Objects")
		return
	end
	local placed = Placedobjects:GetChildren()
	local Bombers = Placedobjects.Bombers:GetChildren()
	local Breakables = Placedobjects.Breakables:GetChildren()
	local s = {}
	for i,v in placed do
		table.insert(s,v)
	end
	for i,v in Breakables do
		table.insert(s,v)
	end
	for i,v in Bombers do
		table.insert(s,v)
	end
	for _, model in ipairs(s) do
		addHitboxOutline(model)
	end

	placedAddedConnection = Placedobjects.ChildAdded:Connect(function(child)
		if child ~= object then
			addHitboxOutline(child)
		end
	end)

	placedRemovedConnection = Placedobjects.ChildRemoved:Connect(function(child)
		removeHitboxOutline(child)
	end)
	
	
	
end

