local function snap(c)
	local newx = math.round(c.X/GridSize)*GridSize
	local newz = math.round(c.Z/GridSize)*GridSize

	return  cframe(newx,0,newz)
end





local function forceTutorialPosition(position)
	if not player:GetAttribute("InTutorial") then
		return position
	end

	local tent = getTutorialTent()

	if not tent or not tent.PrimaryPart then
		return position
	end

	local tentPosition = tent.PrimaryPart.Position

	local target = Vector3.new(position.X, 0, position.Z)
	local tentXZ = Vector3.new(tentPosition.X, 0, tentPosition.Z)

	local fromTent = target - tentXZ
	local tentDistance = fromTent.Magnitude

	if tentDistance > TUTORIAL_TENT_DISTANCE then
		if tentDistance > 0 then
			target = tentXZ + fromTent.Unit * TUTORIAL_TENT_DISTANCE
		else
			target = tentXZ
		end
	end

	return Vector3.new(target.X, position.Y, target.Z)
end

local function calculateModelPosition()

	local finalCFrame = cframe(0,0,0)
	local x,z
	local offsetx,offsetz
	
	if not object then
		warn("no object")
		return cframe(0,0,0)
	end
	
	if not object.PrimaryPart then
		warn("no object PrimaryPart")
		return cframe(0,0,0)
	end


	
	--if RotationVal then
	--	offsetx , offsetz = object.PrimaryPart.Size.X * .5 ,  object.PrimaryPart.Size.Z * .5
	--	x,z = mouse.Hit.X - offsetx , mouse.Hit.Z + offsetz
	--else
	--	offsetx , offsetz = object.PrimaryPart.Size.Z * .5 ,  object.PrimaryPart.Size.X * .5
	--	x,z = mouse.Hit.X - offsetx , mouse.Hit.Z + offsetz
	--end
	
	if RotationVal then
		offsetx = object.PrimaryPart.Size.X * 0.5
		offsetz = object.PrimaryPart.Size.Z * 0.5
	else
		offsetx = object.PrimaryPart.Size.Z * 0.5
		offsetz = object.PrimaryPart.Size.X * 0.5
	end

	x = mouse.Hit.X - offsetx
	z = mouse.Hit.Z - offsetz

	if stackable and mouse.Target and mouse.Target:IsDescendantOf(plot) then
		posY = calculateYPosition(mouse.Target.Position.Y,mouse.Target.Size.Y,object.PrimaryPart.Size.Y)--mouse.Hit.Y
	else
		posY = calculateYPosition(plot.Position.Y,plot.Size.Y,object.PrimaryPart.Size.Y)--mouse.Hit.Y

	end

	if moveByGrid then
		local pltcframe = cframe(plot.CFrame.X,plot.CFrame.Y,plot.CFrame.Z)
		local pos = cframe(x,0,z)
		pos = snap(pos * pltcframe:Inverse())
		finalCFrame = pos * pltcframe * cframe(offsetx,0,offsetz)
		--posX = snap(mouse.Hit.X)
		--posZ = snap(mouse.Hit.Z)
	else
		finalCFrame = cframe(mouse.Hit.X,posY,mouse.Hit.Z)
		--posX = mouse.Hit.X
		--posZ = mouse.Hit.Z
	end

	finalCFrame = bounds(
		cframe(finalCFrame.X, posY, finalCFrame.Z),
		offsetx,
		offsetz
	)

	if player:GetAttribute("InTutorial") then
		local forcedPosition = forceTutorialPosition(finalCFrame.Position)

		finalCFrame = cframe(
			forcedPosition.X,
			posY,
			forcedPosition.Z
		)
	end

	finalCFrame *= angles(0, math.rad(rotation), 0)

	return finalCFrame--cframe(posX,posY,posZ) * angles(0,math.rad(rotation),0)
end

local playPlacePop 
local function translateObj()

	if isPointerOverUI() then
		return
	end

	if pickupMode then

		if object then
			object:Destroy()
		end

		local target = mouse.Target

		if target and target.Parent and target:IsDescendantOf(plot.Placed) then
			local model = target:FindFirstAncestorOfClass("Model")

			if model and model:IsDescendantOf(plot.Placed) then
				lastPickupTarget = model
				pickupHighlight.Adornee = model
			else
				pickupHighlight.Parent = game.ReplicatedStorage
				pickupHighlight.Adornee = nil
			end
		else
			pickupHighlight.Adornee = nil
		end

		return
	end

	if Placedobjects and object and object.Parent == Placedobjects then
		local newPos = calculateModelPosition()

		lastValidCFrame = newPos

		handlecollision(newPos.Position)
		changeHitboxColor()

		object:PivotTo(object.PrimaryPart.CFrame:Lerp(newPos, speed))

		local visual = object:FindFirstChild("Visual")

		if visual then
			local mousePos = Vector2.new(mouse.X, mouse.Y)
			local delta = mousePos - lastMouse
			lastMouse = mousePos

			local targetTilt = Vector2.new(
				math.clamp(-delta.Y * 0.35, -MAX_TILT, MAX_TILT),
				math.clamp(delta.X * 0.35, -MAX_TILT, MAX_TILT)
			)

			local alpha = targetTilt.Magnitude > 0 and TILT_SPEED or RETURN_SPEED
			visualRotation = visualRotation:Lerp(targetTilt, alpha)

			local rot =
				CFrame.Angles(
					math.rad(visualRotation.X),
					0,
					math.rad(visualRotation.Y)
				)

			if visual:IsA("Model") and visual.PrimaryPart then
				visual:PivotTo(object.PrimaryPart.CFrame * rot)
			elseif visual:IsA("BasePart") then
				visual:PivotTo(object.PrimaryPart.CFrame * rot)
			end
		end

		if not lastPosition or (lastPosition and lastPosition ~= newPos) then
			lastPosition = newPos

			if not playPlacePop then
				playPlacePop = true
				SoundsPlay.PlayCloneSFX("Placepops")

				task.delay(0.1, function()
					playPlacePop = false
				end)
			end
		end
	end
end

local function getInstantCFrame()
	return lastValidCFrame or calculateModelPosition()
end

function module:PickupRequest(remote)
	if pickupMode then

		local model = lastPickupTarget

		if model and model.Parent and model:IsDescendantOf(plot.Placed) then
			remote:InvokeServer(model, plot)
			SoundsPlay.PlayCloneSFX("Pickup")
		end

		return
	end
end

function module:PickupCancel(Plot)

	player:SetAttribute("Placing",false)
	
	clearHitboxOutlines()
	plot = Plot
	pickupMode = false
	lastPickupTarget = nil
	if pickupHighlight then
		pickupHighlight:Destroy()
		pickupHighlight = nil
	end
end

